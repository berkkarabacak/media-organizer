<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared styles; every brush is a DynamicResource resolved from the active theme dictionary. -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Window.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
    </Style>
    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Panel.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Panel.Alternating}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Control.Border}"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Toolbar.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundDim}"/>
    </Style>
    <Style TargetType="Border" x:Key="ProgressOverlayBackground">
        <Setter Property="Background" Value="{DynamicResource Brush.Overlay.Background}"/>
    </Style>
    <!-- the one big red action -->
    <Style TargetType="Button" x:Key="DeletePrimaryButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Button" x:Key="DeleteArrowButton" BasedOn="{StaticResource DeletePrimaryButton}">
        <Setter Property="Padding" Value="8,8"/>
    </Style>
    <!-- quiet, link-like buttons for breadcrumbs and the theme toggle -->
    <Style TargetType="Button" x:Key="BreadcrumbButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
    </Style>
    <Style TargetType="Border" x:Key="HintBanner">
        <Setter Property="Background" Value="{DynamicResource Brush.Hint.Background}"/>
    </Style>
</ResourceDictionary>
